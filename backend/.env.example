# Copy to your host's environment settings (never commit real values).
APP_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/hearth
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mixed into every passkey's hash. Changing it makes every issued passkey stop working.
AUTH_SECRET=
# Browser origins allowed to call the API (comma separated; use your HTTPS site in production).
CORS_ORIGINS=
# Set your hosted browser origin, e.g. https://hearth.example.com. Empty supports native apps only.
PRIVACY_CONTACT_EMAIL=rithvika.tiruveedhula51@gmail.com
# How many proxies sit in front of the server (for the per-IP limit). 2 if a CDN is in front.
# TRUSTED_PROXY_HOPS=1

# LLM: Ollama behind the gate (scripts/share-ollama.sh prints these). Leave unset to run
# without it — the phones' own rules still answer everyday messages.
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3:8b
