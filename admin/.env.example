APP_ENV=production
# Same production database and AUTH_SECRET as the API (needed when issuing passkeys).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hearth
AUTH_SECRET=REPLACE_WITH_THE_API_AUTH_SECRET
# Generate a separate token with `openssl rand -hex 32` for each operator.
# Never put real credentials in version control. Removing an entry revokes that operator.
ADMIN_TOKENS={"operator-name":"REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS"}
# Keep this service behind VPN/SSO with HTTPS; do not expose its port publicly.
